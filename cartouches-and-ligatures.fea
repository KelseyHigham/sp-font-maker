  sub e n by enTok;
  sub j o by joTok;
  sub k o by koTok;
  sub l a by laTok;
  sub l i by liTok;
  sub m a by maTok;
  sub m i by miTok;
  sub m u by muTok;
  sub n i by niTok;
  sub p i by piTok;
  sub p u by puTok;
  sub t u by tuTok;
  sub t e by teTok;
  sub t o by toTok;
  sub k u by kuTok;
  sub s u by suTok;
  sub comma space by zerowidth;
  sub a by aTok;
  sub e by eTok;
  sub o by oTok;
  sub bracketleft by cartoucheStartTok;
  sub bracketright by cartoucheEndTok;
  sub period by middotTok;
  sub colon by colonTok;
  sub n by nTok;
} liga;

@cartoucheableGlyph = [
  a e i j k l m n o p s t u w
  middotTok colonTok
  period colon space exclamation question underscore
  aTok
  akesiTok
