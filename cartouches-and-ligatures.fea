lookup add_cartouche_middle {
  # Add a cartouche middle after the glyph.
  # (The cartouche middle is zero-width and extends to the left,
  #  surrounding the glyph.)
  sub         aTok   by         aTok cartoucheMiddleTok;
  sub     akesiTok   by     akesiTok cartoucheMiddleTok;
  sub       alaTok   by       alaTok cartoucheMiddleTok;
  sub     alasaTok   by     alasaTok cartoucheMiddleTok;
