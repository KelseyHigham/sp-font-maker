  sub o l i n by olinTok;
  sub o p e n by openTok;
  sub p a l i by paliTok;
  sub p a n a by panaTok;
  sub p i n i by piniTok;
  sub p i p i by pipiTok;
  sub p o k a by pokaTok;
  sub p o k i by pokiTok;
  sub p o n a by ponaTok;
  sub s a m a by samaTok;
  sub s e l i by seliTok;
