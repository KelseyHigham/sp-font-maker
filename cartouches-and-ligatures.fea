# Adobe feature file format
# This is normally generated and applied in svgtottf.py, to include any custom words needed by the font.
# It's normally applied using fontTools, but it can be applied manually with FontForge.

languagesystem DFLT dflt; # This part is apparently necessary so that
languagesystem latn dflt; # people can edit the font in FontForge after?

feature liga {
  sub k i j e t e s a n t a k a l u by kijetesantakaluTok;
  sub m i s i k e k e by misikekeTok;
  sub k e p e k e n by kepekenTok;
  sub s i t e l e n by sitelenTok;
  sub m o n s u t a by monsutaTok;
