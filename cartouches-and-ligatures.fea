  sub w a s o by wasoTok;
  sub w a w a by wawaTok;
  sub w e k a by wekaTok;
  sub w i l e by wileTok;
  sub l e k o by lekoTok;
  sub s o k o by sokoTok;
  sub m e s o by mesoTok;
  sub a l a by alaTok;
  sub a l e by aleTok;
  sub a n u by anuTok;
  sub i j o by ijoTok;
  sub i k e by ikeTok;
  sub i l o by iloTok;
  sub j a n by janTok;
  sub k e n by kenTok;
