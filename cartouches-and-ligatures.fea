  sub j a k i by jakiTok;
  sub j e l o by jeloTok;
  sub k a l a by kalaTok;
  sub k a m a by kamaTok;
  sub k a s i by kasiTok;
  sub k i l i by kiliTok;
  sub k u l e by kuleTok;
  sub k u t e by kuteTok;
  sub l a p e by lapeTok;
  sub l a s o by lasoTok;
  sub l a w a by lawaTok;
  sub l e t e by leteTok;
  sub l i l i by liliTok;
