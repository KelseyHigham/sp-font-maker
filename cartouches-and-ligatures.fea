  sub       iloTok   by       iloTok cartoucheMiddleTok;
  sub      insaTok   by      insaTok cartoucheMiddleTok;
  sub      jakiTok   by      jakiTok cartoucheMiddleTok;
  sub       janTok   by       janTok cartoucheMiddleTok;
